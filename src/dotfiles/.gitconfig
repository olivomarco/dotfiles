[credential]
	helper = store
[http]
	sslVerify = false
[pull]
	rebase = true
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true	# use n and N to move between diff sections
	light = false # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
	side-by-side = true
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
# machine-specific / private git settings (untracked; keeps the repo clean).
# put per-machine config such as [user] name/email here instead of editing this
# file. a missing file is silently ignored. included last so it overrides above.
[include]
	path = ~/.gitconfig.local
